rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---

    // Hardcoded super admins (cannot be removed via the Settings UI; that
    // prevents accidental lockout if the access doc gets nuked).
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'raedelkady@gmail.com',
          'nizarelkady@gmail.com'
        ];
    }

    // Dynamic admin/viewer lists, managed via Settings in the app. The
    // access doc is GLOBAL (one team across all competitions/years) and
    // lives at /competitions/_app/config/access. The old per-competition
    // path (batroun-race-2026) is kept as a fallback so nobody is locked
    // out while the app migrates the doc to the new location.
    function accessDoc() {
      return get(/databases/$(database)/documents/competitions/_app/config/access).data;
    }
    function legacyAccessDoc() {
      return get(/databases/$(database)/documents/competitions/batroun-race-2026/config/access).data;
    }
    function inDynamicList(field) {
      return request.auth != null
          && request.auth.token.email_verified == true
          && (
               (exists(/databases/$(database)/documents/competitions/_app/config/access)
                 && request.auth.token.email in accessDoc().get(field, []))
            || (exists(/databases/$(database)/documents/competitions/batroun-race-2026/config/access)
                 && request.auth.token.email in legacyAccessDoc().get(field, []))
          );
    }

    function isAdmin()  { return isSuperAdmin() || inDynamicList('admins'); }
    function isViewer() { return inDynamicList('viewers'); }
    // Scanner-only staff: may look a registration up by its known ref and
    // mark bib pickup (check-in fields), but cannot list registrations or
    // reach the admin dashboard.
    function isScanner() { return inDynamicList('scanners'); }
    function canReadDashboard() { return isAdmin() || isViewer(); }

    function isValidNewRegistration() {
      let d = request.resource.data;
      return d.firstName is string && d.firstName.size() > 0 && d.firstName.size() < 100
        && d.lastName  is string && d.lastName.size()  > 0 && d.lastName.size()  < 100
        && d.email     is string && d.email.size()     < 200
        && d.phone     is string && d.phone.size()     > 0
        && d.categoryId is string
        && d.whishReference is string
        // payment fields locked on create
        && (d.paymentStatus == 'pending' || d.paymentStatus == 'free')
        && (!('bibNumber' in d.keys()) || d.bibNumber == null)
        && (!('paidAt' in d.keys())    || d.paidAt    == null)
        // consents required
        && d.consents.waiver    == true
        && d.consents.dataUsage == true;
    }

    // A visitor who fills the form and leaves writes nothing today — the
    // first write is the submit itself, so the drop-off is invisible. An
    // attempt doc is the trail they leave once they are contactable. It
    // carries a phone and an email, so the public may write one but never
    // read one back.
    function isValidAttempt() {
      let d = request.resource.data;
      return d.phone is string && d.phone.size() > 0 && d.phone.size() < 40
        && (!('email'     in d.keys()) || d.email     is string && d.email.size()     < 200)
        && (!('firstName' in d.keys()) || d.firstName is string && d.firstName.size() < 100)
        && (!('lastName'  in d.keys()) || d.lastName  is string && d.lastName.size()  < 100)
        && (!('src'       in d.keys()) || d.src == null || (d.src is string && d.src.size() < 60))
        && (!('categoryId' in d.keys()) || d.categoryId == null || (d.categoryId is string && d.categoryId.size() < 80))
        && d.keys().hasOnly(['phone', 'firstName', 'lastName', 'email', 'categoryId',
                             'src', 'startedAt', 'lastSeenAt', 'completedAt']);
    }

    function registrationOpen(competitionId) {
      // Allow registration when:
      //   - the competition doc doesn't exist yet, OR
      //   - we are inside the [registrationOpens, registrationCloses) window.
      // Either bound being null means "no limit on that side".
      let compPath = /databases/$(database)/documents/competitions/$(competitionId);
      let opens  = get(compPath).data.get('registrationOpens',  null);
      let closes = get(compPath).data.get('registrationCloses', null);
      return !exists(compPath)
          || (
              (opens  == null || request.time >= opens)
           && (closes == null || request.time <  closes)
          );
    }

    // --- Routes ---

    match /competitions/{competitionId} {
      allow read:  if true;
      allow write: if isAdmin();

      // Categories: public read (page needs them), admin write.
      // EXCEPTION: staff (viewers) confirming a payment must atomically bump
      // the category's bibCursor (and registeredCount) as part of assigning
      // the next bib. Allow a viewer to UPDATE a category only when the sole
      // changed fields are those counters — everything else stays admin-only.
      match /categories/{categoryId} {
        allow read:  if true;
        allow write: if isAdmin();
        allow update: if canReadDashboard()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['bibCursor', 'registeredCount']);
      }

      // Theme / form-schema / arbitrary config docs: public read, admin write.
      // EXCEPT /config/access which contains staff emails — that's restricted
      // to authenticated users (to avoid leaking emails publicly).
      match /config/access {
        allow read:  if request.auth != null;
        allow write: if isAdmin();
      }
      match /config/{configId} {
        allow read:  if true;
        allow write: if isAdmin();
      }

      // Registrations:
      //   - admin + viewer can READ and UPDATE (approve payment, soft-delete)
      //   - only admin can HARD DELETE (from the Backup tab)
      //   - public can CREATE only.
      // Soft-delete = setting deletedAt on the doc; the row is hidden from
      // the main dashboard but kept for admin backup review.
      match /registrations/{regId} {
        // get-by-known-id is public so the "sign in with mobile + ref" flow
        // on the public page can look up a single registration by its ref.
        // listing all registrations is still locked to admin / viewer.
        allow get:    if true;
        allow list:   if canReadDashboard();
        // Public form: strict validation + registration window.
        // Admin / viewer: allowed unconditionally so the "Repair legacy
        // registrations" maintenance tool can recreate broken docs at
        // their correct ref-as-id path even after registration closes.
        allow create: if canReadDashboard()
                       || (isValidNewRegistration() && registrationOpen(competitionId));
        // Admin / viewer can update any field. Scanner-only staff may update
        // ONLY the bib-pickup / check-in fields plus the scan-tracking
        // timestamp (written on every lookup) — nothing else.
        allow update: if canReadDashboard()
                       || (isScanner()
                           && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['checkedInAt', 'checkedInBy',
                                          'teammateCheckedInAt', 'teammateCheckedInBy',
                                          'scannedAt', 'scannedBy']));
        allow delete: if isAdmin();
      }

      // Per-phone index of registration refs. Lets a signed-in runner
      // pull every registration filed under their mobile in one go,
      // without granting public list access on the registrations
      // collection. Public can read and append; only admins can delete.
      match /phoneIndex/{phoneId} {
        allow read: if true;
        allow create, update:
          if request.resource.data.refs is list
          && request.resource.data.refs.size() <= 50;
        allow delete: if isAdmin();
      }

      // Unfinished registrations. Doc id = normalized phone, so a visitor
      // who tries twice leaves one row rather than a pile, and the admin
      // side can match an attempt against a real registration by phone.
      // Write-only for the public, same as a suggestion box: they cannot
      // read anyone else's contact details back out.
      match /attempts/{attemptId} {
        allow get, list: if canReadDashboard();
        // id must equal the phone inside, so a visitor can only ever write
        // their own row and cannot scatter docs across the collection
        allow create: if isValidAttempt()
                       && request.resource.data.phone == attemptId
                       && registrationOpen(competitionId);
        // no window on the update: the "they finished" stamp must still land
        // if the submit straddles the closing minute, or the row sticks
        // around looking like a drop-off forever.
        // Dashboard staff may also update freely — they stamp waSentAt /
        // emailSentAt when they follow a drop-off up, fields the public
        // validator would reject.
        allow update: if canReadDashboard()
                       || (isValidAttempt() && request.resource.data.phone == attemptId);
        allow delete: if isAdmin();
      }

      // Sponsors and Expenses: ADMIN-ONLY (contain money figures and
      // private contact info; staff don't need access). Tabs are also
      // hidden from staff in the admin UI as a UX layer; this rule is
      // the real gate.
      match /sponsors/{sponsorId} {
        allow read, write: if isAdmin();
      }
      match /expenses/{expenseId} {
        allow read, write: if isAdmin();
      }

      // Phone-based discount pool. Doc id = normalized phone.
      //   - get: public, by EXACT known phone only (the public form looks up
      //     the runner's own number to apply their discount). list is locked
      //     to admin/staff so the full set of discounted numbers isn't
      //     world-readable — same privacy model as /registrations.
      //   - write: admin only (managing comps/discounts is an admin action;
      //     staff can still discount an individual via the registration editor).
      match /discounts/{phoneId} {
        allow get:   if true;
        allow list:  if canReadDashboard();
        allow write: if isAdmin();
      }
    }

    // Everything else: deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
